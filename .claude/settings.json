{
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npx next lint:*)",
      "Bash(git status:*)",
      "Bash(git log --oneline:*)",
      "Bash(git diff --stat:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
