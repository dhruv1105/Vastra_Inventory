# Docker stack settings. Copy to .env (git-ignored) — ./scripts/dev-up.sh does this for you.

# Database (the container creates it on first start)
POSTGRES_DB=vastra
POSTGRES_USER=vastra
POSTGRES_PASSWORD=change-me-locally

# Host ports. 5440 avoids other Postgres servers commonly on 5432-5434.
DB_PORT=5440
APP_PORT=3000

# Auth (better-auth). Production: set a long random secret (openssl rand -base64 32) and the
# public URL. Development works with the defaults below.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Development test owner password (create-owner --dev)
DEV_OWNER_PASSWORD=madhurya-dev

# Phone codes by SMS: "console" prints codes in the app log (development). Real provider: auth phase A6.
SMS_PROVIDER=

# Legacy, removed in auth phase A2
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
