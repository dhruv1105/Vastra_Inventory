# Docker stack settings. Copy to .env (git-ignored) — ./scripts/dev-up.sh does this for you.

# Database (the container creates it on first start)
POSTGRES_DB=vastra
POSTGRES_USER=vastra
POSTGRES_PASSWORD=change-me-locally

# Host ports. 5440 avoids other Postgres servers commonly on 5432-5434.
DB_PORT=5440
APP_PORT=3000

# Auth (better-auth). Production: set a long random secret (openssl rand -base64 32) and the
# public URL. Development works with the defaults below.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Development test owner password (create-owner --dev)
DEV_OWNER_PASSWORD=madhurya-dev

# Google sign-in (optional; existing accounts only). Create an OAuth client in Google Cloud and
# add the redirect URL <BETTER_AUTH_URL>/api/auth/callback/google. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in codes by text message. "console" prints codes in the app log (development only).
# "msg91" sends real texts: needs an MSG91 auth key and a DLT-approved OTP template.
# Empty: the option is hidden.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

